parameters:
    level: 9

    bootstrapFiles:
        - phpstan-bootstrap.php

    paths:
        - src

    ignoreErrors:
        # Shopware 6.7 marks set() and setMultiple() deprecated only because 6.8 adds an optional
        # parameter to them; there is nothing to migrate to. Releases without the notice match nothing.
        -
            identifier: method.deprecated
            message: '#reason:new-optional-parameter#'
            reportUnmatched: false
